#!/bin/bash

if [[ $1 == "" ]]; then
  # echo "shutdown sequence"
  hyprshutdown --post-cmd 'systemctl poweroff'
else
  while getopts "hrv" flag; do
    case $flag in
    h) # display script help info
      echo "Usage: hyshd [options]"
      echo "Options: "
      echo "  -           shuts the system down after hyprshutdown"
      echo "  -h          print hyshd command line options"
      echo "  -r          reboots the system after hyprshutdown"
      echo "  -v          print hyshd version"
      ;;

    r) # reboot the computer
      # echo "reboot sequence"
      hyprshutdown --post-cmd 'systemctl reboot'
      ;;
    v) # display version
      echo "Version 0.1.0"
      ;;
    esac
  done
fi
